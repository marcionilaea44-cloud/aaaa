.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tag {
  background: rgba(14, 75, 143, 0.1);
  color: #0e4b8f;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
}

.price {
  color: #e35b2e;
  font-size: 40rpx;
  font-weight: 700;
  margin: 10rpx 0;
}

.line {
  border-bottom: 1rpx solid #eef1f5;
  padding: 14rpx 0;
}

.line:last-child {
  border-bottom: none;
}
