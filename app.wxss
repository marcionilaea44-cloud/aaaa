page {
  background: #f3f4f6;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.05);
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.primary-btn {
  margin-top: 16rpx;
  border: none;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e0e7ff;
  color: #3730a3;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
